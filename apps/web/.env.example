# Copie para .env.local e ajuste. Nunca commite .env.local.

# Vazio = PGlite local em ./.data/pglite (dev). Produção: postgres://usuario:senha@host:5432/banco
DATABASE_URL=

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=troque-este-segredo-em-producao-por-32-bytes-aleatorios
BETTER_AUTH_URL=http://localhost:3000

# E-mail transacional. Vazio em dev = e-mails visíveis em http://localhost:3000/dev/emails
SMTP_URL=
EMAIL_FROM="FORJA FITNESS <nao-responda@exemplo.com>"

# Login social (opcional): os botões só aparecem quando configurados.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
